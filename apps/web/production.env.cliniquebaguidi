# .env de PRODUCTION du relais SIGH-CBG — Clinique Baguidi « L'As du Cœur ».
# À copier en `apps/web/.env` SUR LE SERVEUR (jamais dans le dépôt), puis compléter les champs vides (secrets).
# Domaine : https://sighnbg.cliniquebaguidi.com  (racine web du sous-domaine = dossier public/)

APP_NAME="SIGH-CBG Relais"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sighnbg.cliniquebaguidi.com
APP_KEY=                       # produire sur le poste de développement : php artisan key:generate --show
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Base PostgreSQL créée dans cPanel (noms préfixés par l'utilisateur cPanel).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=CPANEL_relais
DB_USERNAME=CPANEL_relais
DB_PASSWORD=

# Pas de Redis, pas de démon : tout passe par la base et par le cron (schedule:run chaque minute).
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Secret partagé avec la console de la mère (le MÊME texte y est saisi à « Activer la mère »). Long et aléatoire.
RELAIS_SECRET_MERE=
RELAIS_SEUIL_BATTEMENT_MS=300000
RELAIS_BANC=false

# Messagerie (alertes du panneau). Compte à créer dans cPanel ; adresse proposée, à confirmer par la clinique.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.cliniquebaguidi.com
MAIL_PORT=587
MAIL_USERNAME=contact@cliniquebaguidi.com
MAIL_PASSWORD=
MAIL_TIMEOUT=20
MAIL_FROM_ADDRESS=contact@cliniquebaguidi.com
MAIL_FROM_NAME="Clinique Baguidi"
MAIL_REPLY_TO_ADDRESS=contact@cliniquebaguidi.com
MAIL_REPLY_TO_NAME="Clinique Baguidi"

# ADR-0009 : SMS par le relais. « journal » n'envoie rien (essai) ; passer à « http » une fois le fournisseur choisi.
RELAIS_SMS_PILOTE=journal
RELAIS_SMS_PLAFOND_JOUR=100
RELAIS_SMS_TENTATIVES_MAX=5
RELAIS_SMS_CONSERVATION_JOURS=30
RELAIS_SMS_HTTP_URL=
RELAIS_SMS_HTTP_CLE=
RELAIS_SMS_HTTP_ENTETE_CLE=Authorization
RELAIS_SMS_HTTP_PREFIXE_CLE="Bearer "
RELAIS_SMS_EXPEDITEUR=
RELAIS_SMS_HTTP_CHAMP_NUMERO=to
RELAIS_SMS_HTTP_CHAMP_TEXTE=text
RELAIS_SMS_HTTP_CHAMP_EXPEDITEUR=from

# Satisfaction en ligne (réponses chiffrées dans le navigateur, illisibles par le relais).
RELAIS_SATISFACTION_DEBIT_PAGE=60
RELAIS_SATISFACTION_DEBIT_DEPOT=10
RELAIS_SATISFACTION_PLAFOND_JOUR=500
RELAIS_SATISFACTION_CONSERVATION_JOURS=30
