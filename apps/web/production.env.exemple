# Modèle de .env pour le cPanel (à copier en `.env` sur le serveur — JAMAIS dans le dépôt).
APP_NAME="SIGH-CBG Relais"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sighnbg.cliniquebaguidi.com
APP_KEY=                       # produire avec : php artisan key:generate --show   (sur le poste de développement)
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cpanelutilisateur_relais
DB_USERNAME=cpanelutilisateur_relais
DB_PASSWORD=

# Pas de Redis, pas de démon : tout passe par la base et par le cron.
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=daily
LOG_LEVEL=warning

RELAIS_SECRET_MERE=            # long, aléatoire ; le même est saisi sur la console de la mère
RELAIS_SEUIL_BATTEMENT_MS=300000
RELAIS_BANC=false

# Messagerie (alertes du panneau). Compte à créer dans cPanel ; valeurs NON secrètes de la Clinique Baguidi, le mot de passe se saisit sur le serveur ou dans le panneau, jamais ici.
# 587 en STARTTLS (MAIL_SCHEME=smtp) ; 465 en SSL implicite (MAIL_SCHEME=smtps). MAIL_MAILER=log n'envoie rien (essai) ; smtp envoie réellement.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.cliniquebaguidi.com
MAIL_PORT=587
MAIL_USERNAME=contact@cliniquebaguidi.com
MAIL_PASSWORD=
MAIL_TIMEOUT=20
MAIL_FROM_ADDRESS=contact@cliniquebaguidi.com
MAIL_FROM_NAME="Clinique Baguidi"
MAIL_REPLY_TO_ADDRESS=contact@cliniquebaguidi.com
MAIL_REPLY_TO_NAME="Clinique Baguidi"

# ADR-0009 : SMS par le relais. Les identifiants du fournisseur ne vivent QUE dans ce fichier, jamais dans le dépôt.
RELAIS_SMS_PILOTE=journal          # journal (n'envoie rien, essai) | twilio | vonage | http (pilote générique réglé ci-dessous)
RELAIS_SMS_PLAFOND_JOUR=100
RELAIS_SMS_TENTATIVES_MAX=5        # cinq au plus
RELAIS_SMS_VALIDITE_HEURES=24      # un SMS en attente depuis plus longtemps est abandonné (statut « expire », numéro et texte effacés)
RELAIS_SMS_CONSERVATION_JOURS=30
RELAIS_SMS_HTTP_URL=
RELAIS_SMS_HTTP_CLE=
RELAIS_SMS_HTTP_ENTETE_CLE=Authorization
RELAIS_SMS_HTTP_PREFIXE_CLE="Bearer "
RELAIS_SMS_EXPEDITEUR=
RELAIS_SMS_HTTP_CHAMP_NUMERO=to
RELAIS_SMS_HTTP_CHAMP_TEXTE=text
RELAIS_SMS_HTTP_CHAMP_EXPEDITEUR=from
# Fournisseur « twilio » (API Messages) : SID, jeton et expéditeur (ou service de messagerie). Valeurs à saisir sur le serveur, jamais dans le dépôt.
RELAIS_SMS_TWILIO_SID=
RELAIS_SMS_TWILIO_TOKEN=
RELAIS_SMS_TWILIO_SERVICE=
# Fournisseur « vonage » (API SMS) : clé, secret et expéditeur (numéro ou nom alphanumérique admis au Bénin).
RELAIS_SMS_VONAGE_CLE=
RELAIS_SMS_VONAGE_SECRET=
